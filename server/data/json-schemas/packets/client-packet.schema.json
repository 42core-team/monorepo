{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"title": "Client Actions Packet",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"actions"
	],
	"properties": {
		"actions": {
			"type": "array",
			"items": {
				"type": "object"
			}
		},
		"debug_data": {
			"type": "array",
			"items": {
				"type": "object",
				"required": [
					"object_id",
					"object_info"
				],
				"properties": {
					"object_id": {
						"type": "number"
					},
					"object_info": {
						"type": "string"
					}
				}
			}
		}
	},
	"examples": [
		{
			"actions": [
				{
					"type": "move",
					"unit_id": 1,
					"x": 2,
					"y": 3
				}
			],
			"debug_data": [
				{
					"object_id": 1,
					"object_info": "Moving to target deposit"
				}
			]
		}
	]
}