{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"title": "Client Actions Packet",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"actions"
	],
	"properties": {
		"actions": {
			"type": "array",
			"items": {
				"type": "object"
			}
		}
	},
	"examples": [
		{
			"actions": [
				{
					"type": "move",
					"unit_id": 1,
					"x": 2,
					"y": 3
				}
			]
		}
	]
}