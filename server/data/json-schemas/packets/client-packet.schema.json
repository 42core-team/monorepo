{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"title": "Client Actions Packet",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"actions"
	],
	"properties": {
		"actions": {
			"type": "array",
			"items": {
				"type": "object"
			}
		},
		"debug_data": {
			"type": "array",
			"items": {
				"type": "object",
				"required": [
					"object_id"
				],
				"properties": {
					"object_id": {
						"type": "number"
					},
					"object_info": {
						"type": "string"
					},
					"object_path": {
						"type": "array",
						"items": {
							"type": "object",
							"required": [
								"x",
								"y"
							],
							"properties": {
								"x": {
									"type": "number"
								},
								"y": {
									"type": "number"
								}
							}
						}
					}
				}
			}
		}
	},
	"examples": [
		{
			"actions": [
				{
					"type": "move",
					"unit_id": 1,
					"x": 2,
					"y": 3
				}
			],
			"debug_data": [
				{
					"object_id": 1,
					"object_info": "Moving to target deposit",
					"object_path": [
						{
							"x": 23,
							"y": 17
						}
					]
				}
			]
		}
	]
}