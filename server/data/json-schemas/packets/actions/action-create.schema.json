{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"title": "Create Action",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"type",
		"components"
	],
	"properties": {
		"type": {
			"type": "string",
			"const": "create"
		},
		"name": {
			"type": "string",
			"minLength": 1,
			"maxLength": 32
		},
		"components": {
			"type": "array",
			"minItems": 1,
			"items": {
				"type": "string",
				"minLength": 1
			}
		}
	},
	"examples": [
		{
			"type": "create",
			"components": [
				"COMPONENT_ID_1",
				"COMPONENT_ID_2",
				"COMPONENT_ID_3"
			]
		}
	]
}