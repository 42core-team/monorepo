{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"title": "Create Action",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"type",
		"name",
		"components"
	],
	"properties": {
		"type": {
			"type": "string",
			"const": "create"
		},
		"name": {
			"oneOf": [
				{
					"type": "string",
					"minLength": 1,
					"maxLength": 32
				},
				{
					"type": "null"
				}
			]
		},
		"components": {
			"type": "array",
			"minItems": 1,
			"items": {
				"type": "string",
				"minLength": 1
			}
		}
	},
	"examples": [
		{
			"type": "create",
			"name": null,
			"components": [
				"COMPONENT_ID_1",
				"COMPONENT_ID_2",
				"COMPONENT_ID_3"
			]
		}
	]
}
