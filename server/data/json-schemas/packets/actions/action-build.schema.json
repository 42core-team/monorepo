{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"title": "Build Action",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"type",
		"unit_id",
		"x",
		"y"
	],
	"properties": {
		"type": {
			"type": "string",
			"const": "build"
		},
		"unit_id": {
			"type": "integer",
			"minimum": 0
		},
		"x": {
			"type": "integer",
			"minimum": 0
		},
		"y": {
			"type": "integer",
			"minimum": 0
		}
	},
	"examples": [
		{
			"type": "build",
			"unit_id": 3,
			"x": 8,
			"y": 8
		}
	]
}