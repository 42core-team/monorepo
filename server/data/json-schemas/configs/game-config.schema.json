{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GameConfig",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "gridSize",
    "idleIncome",
    "idleIncomeTimeOut",
    "depositHp",
    "depositIncome",
    "gemPileIncome",
    "coreHp",
    "initialBalance",
    "wallHp",
    "worldGenerator",
    "worldGeneratorConfig",
    "components",
    "corePositions"
  ],
  "properties": {
    "gridSize": {
      "type": "integer",
      "minimum": 2,
      "maximum": 200
    },
    "seed": {
      "type": "string"
    },
    "idleIncome": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000000
    },
    "idleIncomeTimeOut": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000000
    },
    "depositHp": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000000
    },
    "depositIncome": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000000
    },
    "gemPileIncome": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000000
    },
    "coreHp": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000000
    },
    "initialBalance": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000000
    },
    "wallHp": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000000
    },
    "worldGenerator": {
      "type": "string",
      "enum": [
        "jigsaw",
        "sparse",
        "hardcoded",
        "empty"
      ]
    },
    "worldGeneratorConfig": {
      "type": "object"
    },
    "components": {
      "$ref": "#/$defs/componentsCfg"
    },
    "corePositions": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/position"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "worldGenerator": {
            "const": "jigsaw"
          }
        },
        "required": [
          "worldGenerator"
        ]
      },
      "then": {
        "properties": {
          "worldGeneratorConfig": {
            "$ref": "#/$defs/jigsawCfg"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "worldGenerator": {
            "const": "sparse"
          }
        },
        "required": [
          "worldGenerator"
        ]
      },
      "then": {
        "properties": {
          "worldGeneratorConfig": {
            "$ref": "#/$defs/sparseCfg"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "worldGenerator": {
            "const": "hardcoded"
          }
        },
        "required": [
          "worldGenerator"
        ]
      },
      "then": {
        "properties": {
          "worldGeneratorConfig": {
            "$ref": "#/$defs/hardcodedCfg"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "worldGenerator": {
            "const": "empty"
          }
        },
        "required": [
          "worldGenerator"
        ]
      },
      "then": {
        "properties": {
          "worldGeneratorConfig": {
            "$ref": "#/$defs/emptyCfg"
          }
        }
      }
    }
  ],
  "$defs": {
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "y": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        }
      }
    },
    "componentPropertyName": {
      "type": "string",
      "enum": [
        "hp",
        "baseActionCooldown",
        "balancePerCooldownStep",
        "maxBalance",
        "damageReductionPercent",
        "damageCore",
        "damageUnit",
        "damageObject",
        "postSpawnCoreCooldown"
      ]
    },
    "unitDefaultProperties": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hp",
        "baseActionCooldown",
        "balancePerCooldownStep",
        "maxBalance",
        "damageReductionPercent",
        "damageCore",
        "damageUnit",
        "damageObject",
        "postSpawnCoreCooldown"
      ],
      "properties": {
        "hp": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000
        },
        "baseActionCooldown": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000
        },
        "balancePerCooldownStep": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000
        },
        "maxBalance": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000
        },
        "damageReductionPercent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "damageCore": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000
        },
        "damageUnit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000
        },
        "damageObject": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000
        },
        "postSpawnCoreCooldown": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000
        }
      }
    },
    "componentPropertyModification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "modification"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/componentPropertyName"
        },
        "modification": {
          "type": "integer",
          "minimum": -10000000,
          "maximum": 10000000
        }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "properties",
        "cost",
        "visualizer_asset_prioritized",
        "visualizer_asset_path"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "properties": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/componentPropertyModification"
          }
        },
        "cost": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000
        },
        "visualizer_asset_prioritized": {
          "type": "boolean"
        },
        "visualizer_asset_path": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "componentsCfg": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxComponentsPerUnit",
        "unitDefaultProperties",
        "components",
        "invalidConditions"
      ],
      "properties": {
        "maxComponentsPerUnit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000
        },
        "unitDefaultProperties": {
          "$ref": "#/$defs/unitDefaultProperties"
        },
        "components": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/component"
          }
        },
        "invalidConditions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/invalidCondition"
          }
        }
      }
    },
    "invalidCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message",
        "condition"
      ],
      "properties": {
        "message": {
          "type": "string",
          "minLength": 1
        },
        "condition": {
          "$ref": "#/$defs/invalidConditionExpr"
        }
      }
    },
    "invalidConditionExpr": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "const",
            "property",
            "component_count",
            "sum",
            "subtract",
            "multiply",
            "divide",
            "min",
            "max",
            "less_than",
            "greater_than",
            "less_than_or_equal",
            "greater_than_or_equal",
            "equal",
            "not",
            "ternary"
          ]
        },
        "value": {
          "type": "integer",
          "minimum": -10000000,
          "maximum": 10000000
        },
        "property": {
          "$ref": "#/$defs/componentPropertyName"
        },
        "component": {
          "type": "string",
          "minLength": 1
        },
        "1": {
          "type": "object"
        },
        "2": {
          "type": "object"
        },
        "if": {
          "type": "object"
        },
        "then": {
          "type": "object"
        },
        "else": {
          "type": "object"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "const"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "value"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "property"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "property"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "component_count"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "component"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "sum",
                  "subtract",
                  "multiply",
                  "divide",
                  "min",
                  "max",
                  "less_than",
                  "greater_than",
                  "less_than_or_equal",
                  "greater_than_or_equal",
                  "equal"
                ]
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "1",
              "2"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "not"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "1"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "ternary"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "if",
              "then",
              "else"
            ]
          }
        }
      ]
    },
    "jigsawCfg": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "templatePlaceAttemptCount",
        "additionalWallPlaceAttemptCount",
        "depositCount",
        "gemPileCount",
        "minTemplateSpacing",
        "minCoreDistance",
        "depositAdditionalIncomePerAdjacentWall",
        "depositMultiplierIfFullySurrounded",
        "randomDepositIncomeVariation",
        "randomGemPileIncomeVariation"
      ],
      "properties": {
        "templatePlaceAttemptCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000
        },
        "additionalWallPlaceAttemptCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000
        },
        "depositCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "gemPileCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "minTemplateSpacing": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "minCoreDistance": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "depositAdditionalIncomePerAdjacentWall": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000
        },
        "depositMultiplierIfFullySurrounded": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000
        },
        "randomDepositIncomeVariation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000
        },
        "randomGemPileIncomeVariation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000
        }
      }
    },
    "sparseCfg": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "depositCount",
        "depositBalanceVariation",
        "gemPileCount",
        "gemPileBalanceVariation",
        "wallCount",
        "coreBuffer"
      ],
      "properties": {
        "depositCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "depositBalanceVariation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000
        },
        "gemPileCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "gemPileBalanceVariation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000
        },
        "wallCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "coreBuffer": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        }
      }
    },
    "hardcodedCfg": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "map"
      ],
      "properties": {
        "map": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "emptyCfg": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 0
    }
  }
}